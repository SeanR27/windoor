# Repository-wide generated files and local configuration.

# Python bytecode, caches, virtual environments, and local secrets.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
.env

# SQLite data and database side files created at runtime.
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# JavaScript dependencies, build output, and local frontend settings.
frontend/node_modules/
frontend/dist/
frontend/.env

# Common editor and operating-system noise.
.DS_Store
Thumbs.db
.idea/
.vscode/
